rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return signedIn() && profile().data.status == 'approved'; }
    function admin() { return approved() && profile().data.role == 'admin'; }

    match /users/{uid} {
      allow create: if own(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';
      allow read: if own(uid) || admin();
      allow update: if admin() || (own(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role);
      allow delete: if admin();

      match /medicines/{medicineId} {
        allow read: if own(uid) && approved();
        allow create, update, delete: if own(uid) && approved();
      }
      match /intakes/{intakeId} {
        allow read: if own(uid) && approved();
        allow create, update, delete: if own(uid) && approved();
      }
      match /documentDrafts/{draftId} {
        allow read, update, delete: if own(uid) && approved();
        allow create: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
